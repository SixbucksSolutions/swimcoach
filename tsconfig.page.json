{
  // The page (MVP-08): plain JavaScript ES modules in public/js, checked as JSDoc-typed code
  // (docs/planning/t4-interfaces.md, "Language"). The browser runs the committed bytes, so nothing
  // here emits. test/page holds the page's unit tests, which import those modules.
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": [],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["public/js", "test/page"]
}
