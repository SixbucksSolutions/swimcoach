{
  "name": "swimcoach",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted, mobile-first status board for agent-run software projects",
  "license": "MIT",
  "scripts": {
    "postinstall": "npm ci --prefix cli",
    "types": "wrangler types src/worker-configuration.d.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p cli/tsconfig.json",
    "lint": "biome check --error-on-warnings . && node scripts/biome-no-infos.mjs",
    "test": "vitest run",
    "check": "wrangler types --check src/worker-configuration.d.ts && npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@cfworker/json-schema": "4.1.6",
    "@cloudflare/vitest-plugin": "1.8.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.162.0"
  },
  "dependencies": {
    "jose": "6.2.17"
  }
}
